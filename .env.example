# Copy to .env and adjust as needed: `cp .env.example .env`

# --- Postgres (used by docker-compose to provision the db service) ---
POSTGRES_USER=citynext
POSTGRES_PASSWORD=citynext
POSTGRES_DB=citynext

# --- Application ---
PORT=8080
# When running the app OUTSIDE compose, point at localhost instead of `db`:
# DATABASE_URL=postgres://citynext:citynext@localhost:5432/citynext?sslmode=disable
NAGER_BASE_URL=https://date.nager.at
TIMEZONE=Europe/London

# Optional tuning (defaults shown):
# DB_MAX_CONNS=10
# HTTP_TIMEOUT=5s
# REQUEST_TIMEOUT=10s
# DB_CONNECT_RETRIES=10
# DB_CONNECT_BACKOFF=1s

# --- Integration tests (make test-integration) ---
# TEST_DATABASE_URL=postgres://citynext:citynext@localhost:5432/citynext?sslmode=disable
